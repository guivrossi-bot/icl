{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/regressionmodel", "destination": "/regressionmodel/index.html" },
    { "source": "/regressionmodel/(.*)", "destination": "/regressionmodel/$1" },
    { "source": "/plasmavsoxy", "destination": "/plasmavsoxy/index.html" },
    { "source": "/plasmavsoxy/(.*)", "destination": "/plasmavsoxy/$1" },
    { "source": "/((?!regressionmodel|plasmavsoxy).*)", "destination": "/index.html" }
  ]
}
